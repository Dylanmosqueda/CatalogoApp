@{
    ViewData["Title"] = "UAC COMMAND CENTER";
}

<div class="container text-center mt-5">
    <!-- Icono estilo Doom -->
    <div class="mb-4">
        <span style="font-size: 6rem; color: #8b0000; text-shadow: 2px 2px #000;">☣</span>
    </div>

    <!-- Título con estilo industrial -->
    <h1 class="display-2" style="font-family: 'Bangers', cursive; color: #ff3333; letter-spacing: 5px; text-transform: uppercase;">
        BIENVENIDO, MARINE
    </h1>

    <p class="text-uppercase lead" style="color: #ffcc00; font-weight: bold; letter-spacing: 2px; border-bottom: 1px solid #8b0000; display: inline-block; padding: 5px;">
